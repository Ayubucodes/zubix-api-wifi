# Copy to .env and fill in. Never commit .env.

APP_ENV=development
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_NAME=Zubix WiFi
# Shown to customers on the portal as a tap-to-call number. Optional.
SUPPORT_PHONE=

# Database / cache
POSTGRES_USER=zubix
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=zubix_wifi
DATABASE_URL=postgresql://zubix:change-me-strong-password@localhost:5432/zubix_wifi?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
ADMIN_URL=http://localhost:5173
PORTAL_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Voucher code encryption at rest (generate with: openssl rand -hex 32)
VOUCHER_ENCRYPTION_KEY=
VOUCHER_HMAC_KEY=

# Omada controller. Used when a customer's phone is let onto the Wi-Fi after paying.
# Leave blank until the controller is ready: the portal then tells the customer to ask staff.
# Unverified on real hardware. See docs/OMADA_SETUP.md.
OMADA_CONTROLLER_URL=
OMADA_USERNAME=
OMADA_PASSWORD=
OMADA_SITE_ID=
# Omada External Portal paths. The vendor article's samples disagree; confirm on your controller.
OMADA_LOGIN_PATH=/api/v2/hotspot/login
OMADA_AUTHORIZE_PATH=/api/v2/hotspot/extPortal/auth

# Payment providers (not yet wired; see docs/PAYMENT_SETUP.md)
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
CLICKPESA_BASE_URL=
CLICKPESA_CLIENT_ID=
# CLICKPESA_CLIENT_SECRET is sent to ClickPesa as the api-key header
CLICKPESA_CLIENT_SECRET=
CLICKPESA_CHECKSUM_SECRET=

# Notifications (not yet wired)
SMS_PROVIDER=
SMS_API_KEY=

# Initial administrator created by `npm run db:seed` (password is generated if empty)
SEED_ADMIN_EMAIL=admin@zubix.local
SEED_ADMIN_PASSWORD=
