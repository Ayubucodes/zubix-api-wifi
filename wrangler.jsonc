{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zubix-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    "APP_TIMEZONE": "Africa/Dar_es_Salaam",
    "CORS_ORIGINS": "https://wifi.zubix.win,https://admin.zubix.win"
  },
  "observability": {
    "enabled": true
  }
}
